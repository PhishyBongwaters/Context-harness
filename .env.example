# Copy to .env (project root) or %APPDATA%/context-harness/.env on Windows
# (~/.config/context-harness/.env elsewhere). Real env vars always win.
# Never commit .env — it holds secrets.

# Cloud keys (set the one your provider needs)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional janitor model keys (prune_* turns fall back to main when unset)
# OPENAI_PRUNE_API_KEY=
# ANTHROPIC_PRUNE_API_KEY=
